{
  "name": "chickenbot.si",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --port=3000 web/index.html",
    "build": "bun scripts/build.js",
    "build:cdn": "bun scripts/build.js --three=cdn",
    "preview": "bun scripts/preview.js",
    "lint": "biome ci --error-on-warnings web scripts tests",
    "format": "biome check --write web scripts tests",
    "test:e2e": "bun test tests/e2e",
    "check": "bun run lint && bun run build && bun run test:e2e && bun run test:visual",
    "test:visual": "bun test tests/visual"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "pixelmatch": "^7.2.0",
    "playwright": "^1.63.0",
    "pngjs": "^7.0.0"
  },
  "dependencies": {
    "three": "^0.186.0"
  }
}
