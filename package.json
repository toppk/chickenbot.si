{
  "name": "chickenbot.si",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --port=3000 web/index.html",
    "build": "bun scripts/build.ts",
    "build:cdn": "bun scripts/build.ts --three=cdn",
    "preview": "bun scripts/preview.ts",
    "lint": "biome ci --error-on-warnings web shared scripts tests",
    "format": "biome check --write web shared scripts tests",
    "typecheck": "tsc -p web && tsc -p .",
    "test:e2e": "bun test tests/e2e",
    "test:visual": "bun test tests/visual",
    "check": "bun run lint && bun run typecheck && bun run build && bun run test:e2e && bun run test:visual"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@types/bun": "^1.4.2",
    "@types/pngjs": "^6.0.5",
    "@types/three": "~0.186.0",
    "pixelmatch": "^7.2.0",
    "playwright": "^1.63.0",
    "pngjs": "^7.0.0",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "three": "^0.186.0"
  }
}
